# Self-hosted Umami analytics (optional — only set in production).
# NEXT_PUBLIC_*  → baked into client bundle, must be set at build time (Coolify build args).
# Leave unset locally to keep dev traffic out of the dashboard.
NEXT_PUBLIC_UMAMI_SRC=https://stats.67projects.app/ascii.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
