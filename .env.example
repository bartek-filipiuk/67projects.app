NODE_ENV=development
PAYLOAD_SECRET=replace-with-32-bytes-of-randomness-min-len-32
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sixtyseven
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
GITHUB_TOKEN=ghp_replace_with_pat_with_public_repo_scope
ADMIN_EMAIL=bartek@67projects.app
ADMIN_PASSWORD=replace-with-strong-password-min-12-chars
